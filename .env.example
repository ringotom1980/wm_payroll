# ==========================================================
# 旺苗人員薪資管理系統（wm_payroll）
# 這是範本檔，請複製為 .env 後填入實際值
# ==========================================================

# ---------- APP ----------
APP_NAME="旺苗人員薪資管理"
APP_ENV=production        # development / production
TIMEZONE=Asia/Taipei
LOG_LEVEL=INFO

# ---------- Database ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=u327657097_wm_payroll
DB_USER=u327657097_wm_admin
DB_PASS=

# ---------- Charset ----------
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_general_ci

# ---------- Security ----------
SESSION_NAME=wm_payroll_sid
SESSION_LIFETIME=1440        # 秒（預設 24 分鐘）
COOKIE_SAMESITE=Lax          # Lax / Strict / None
COOKIE_SECURE=true         # 若網站是 HTTPS，請改為 true

# ---------- Optional SSL (若 DB 啟用加密連線) ----------
DB_SSL_CA=
DB_SSL_CERT=
DB_SSL_KEY=

# ---------- Mail (忘記密碼通知等，可先留空) ----------
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=admin@example.com
MAIL_FROM_NAME="薪資管理系統"

# ---------- System ----------
DEBUG_SQL=false
