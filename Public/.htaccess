# ---------------------------------------------------------------
# wm_payroll/Public/.htaccess
# API 與頁面漂亮網址
# ---------------------------------------------------------------

Options -Indexes
RewriteEngine On

# 1) 實體檔案/資料夾 直接通過
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 2) API 漂亮網址
# 2-1 users：/api/users/login|logout|me|change_password  →  api/users.php?action=...
RewriteRule ^api/users/(login|logout|me|change_password)$ api/users.php?action=$1 [L,QSA]

# 2-2 其他 API：/api/{module} 或 /api/{module}/{action}
#     例：/api/employees/list → api/employees.php?action=list
RewriteRule ^api/(employees|salary_master|payroll_periods|payroll_monthlies|payroll_yearstats|gov_rate_snapshots)/?$ api/$1.php [L,QSA]
RewriteRule ^api/(employees|salary_master|payroll_periods|payroll_monthlies|payroll_yearstats|gov_rate_snapshots)/([a-z_]+)$ api/$1.php?action=$2 [L,QSA]

# 3) 頁面漂亮網址
RewriteRule ^login/?$ auth/login.php [L,QSA]
RewriteRule ^dashboard/?$ dashboard.php [L,QSA]


#    modules：/modules/{頁面} → modules/{頁面}.php
RewriteRule ^modules/(employees|salary_master|payroll_periods|payroll_monthlies|payroll_yearstats|users)/?$ modules/$1.php [L,QSA]

# 4) 安全：阻擋敏感檔案
<FilesMatch "^(\\.env|.*\\.sql|composer\\.(json|lock))$">
  Require all denied
</FilesMatch>
